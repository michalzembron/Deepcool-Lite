<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Product>DeepCool Lite</Product>
    <Company>DeepCool Lite contributors</Company>
    <Copyright>Copyright © 2026 Michał Zembroń</Copyright>

    <!-- Development builds of both apps go into one folder; releases are published with build/publish.ps1 -->
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <AppOutputDir>$(MSBuildThisFileDirectory)artifacts\$(Configuration)\</AppOutputDir>
    <!-- Publishing (framework-dependent or self-contained) must not overwrite the development build -->
    <AppOutputDir Condition="'$(_IsPublishing)' == 'true'">$(BaseOutputPath)publish-build\$(SelfContained)\</AppOutputDir>

    <!-- Keep the footprint small -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Applications only (OutputType is not known yet when this file is imported) -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DeepCoolLite.Service' or '$(MSBuildProjectName)' == 'DeepCoolLite.Settings'">
    <OutputPath>$(AppOutputDir)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Framework-dependent by default; build/publish.ps1 also produces a self-contained release -->
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <ApplicationIcon>$(MSBuildThisFileDirectory)assets\DeepCoolLite.ico</ApplicationIcon>
  </PropertyGroup>
</Project>
