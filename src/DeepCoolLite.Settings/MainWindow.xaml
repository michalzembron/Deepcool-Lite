<Window x:Class="DeepCoolLite.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepCool Lite" Width="680" Height="920" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closed="Window_Closed">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,24">

            <!-- Page header -->
            <TextBlock Text="DeepCool Lite" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource CardDescription}" FontSize="14" Margin="0,2,0,4" TextTrimming="CharacterEllipsis">
                <Run x:Name="DisplayRun" Text="Display" /><Run Text="  ·  " /><Run x:Name="CpuRun" Text="CPU" />
            </TextBlock>

            <!-- Live readings -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,4" Padding="20,16">
                <UniformGrid Columns="4">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TempValue" Text="–" Style="{StaticResource MetricValue}" />
                            <TextBlock x:Name="TempUnit" Text="°C" Style="{StaticResource MetricUnit}" />
                        </StackPanel>
                        <TextBlock Text="Temperature" Style="{StaticResource MetricCaption}" />
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PowerValue" Text="–" Style="{StaticResource MetricValue}" />
                            <TextBlock Text="W" Style="{StaticResource MetricUnit}" />
                        </StackPanel>
                        <TextBlock Text="Power" Style="{StaticResource MetricCaption}" />
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LoadValue" Text="–" Style="{StaticResource MetricValue}" />
                            <TextBlock Text="%" Style="{StaticResource MetricUnit}" />
                        </StackPanel>
                        <TextBlock Text="Usage" Style="{StaticResource MetricCaption}" />
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ClockValue" Text="–" Style="{StaticResource MetricValue}" />
                            <TextBlock Text="MHz" Style="{StaticResource MetricUnit}" />
                        </StackPanel>
                        <TextBlock Text="Clock" Style="{StaticResource MetricCaption}" />
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- Warnings (InfoBar style) -->
            <Border x:Name="WarningBar" Visibility="Collapsed" CornerRadius="8" Padding="16,12" Margin="0,0,0,4"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,1,12,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" x:Name="WarningText" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- Service -->
            <TextBlock Text="Service" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7E8;" Style="{StaticResource CardIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Background service" Style="{StaticResource CardTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="StatusText" Text="…" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Style="{StaticResource CardControl}">
                        <Button x:Name="InstallButton" Content="Install" Style="{DynamicResource AccentButtonStyle}"
                                MinWidth="100" Click="Install_Click" />
                        <Button x:Name="StartButton" Content="Start" MinWidth="90" Margin="8,0,0,0" Click="Start_Click" />
                        <Button x:Name="StopButton" Content="Stop" MinWidth="90" Margin="8,0,0,0" Click="Stop_Click" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE768;" Style="{StaticResource CardIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Start with Windows" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Starts before you sign in. Changing this asks for administrator rights."
                                   Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <CheckBox Grid.Column="2" x:Name="AutostartCheck" Click="Autostart_Click"
                              VerticalAlignment="Center" Margin="16,0,0,0" />
                </Grid>
            </Border>

            <!-- Display settings -->
            <TextBlock Text="Display" Style="{StaticResource SectionHeader}" />
            <TextBlock x:Name="SettingsHint" Style="{StaticResource CardDescription}" Margin="2,0,0,8"
                       Text="Settings are available while the service is running." />
            <StackPanel x:Name="SettingsPanel">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE9CA;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Temperature unit" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" x:Name="UnitCombo" MinWidth="200" VerticalAlignment="Center" Margin="16,0,0,0"
                                  SelectionChanged="Setting_Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE72C;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Refresh interval" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="How often the display is updated" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" x:Name="IntervalCombo" MinWidth="200" VerticalAlignment="Center" Margin="16,0,0,0"
                                  SelectionChanged="Setting_Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xEC4A;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Clock" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Which CPU frequency is shown" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" x:Name="ClockCombo" MinWidth="200" VerticalAlignment="Center" Margin="16,0,0,0"
                                  SelectionChanged="Setting_Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Temperature sensor" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Sensor used for the temperature reading" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" x:Name="SensorCombo" MinWidth="200" VerticalAlignment="Center" Margin="16,0,0,0"
                                  SelectionChanged="Setting_Changed" />
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock Text="About" Style="{StaticResource SectionHeader}" />

            <!-- Update (only when this copy is not the installed one) -->
            <Border x:Name="UpdateCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE896;" Style="{StaticResource CardIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateTitle" Text="Update installed version" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="UpdateDescription" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="UpdateButton" Content="Update" MinWidth="100"
                            Click="Update_Click" VerticalAlignment="Center" Margin="16,0,0,0" />
                </Grid>
            </Border>

            <!-- Uninstall -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE74D;" Style="{StaticResource CardIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Uninstall DeepCool Lite" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Removes the service and restores the official DeepCool app autostart"
                                   Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="UninstallButton" Content="Uninstall" MinWidth="100"
                            Click="Uninstall_Click" VerticalAlignment="Center" Margin="16,0,0,0" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource CardDescription}" Margin="2,16,0,0"
                       Text="Changes are applied immediately. You can close this window – the service keeps running in the background." />
        </StackPanel>
    </ScrollViewer>
</Window>
